[Unit]
Description=RTL-SDR Station Browser (ats-mini-controller)
After=network.target
Wants=network.target

[Service]
Type=simple
User=atsradio
Group=plugdev
WorkingDirectory=/opt/ats-mini-controller
EnvironmentFile=-/etc/ats-mini-controller/env
ExecStart=/usr/bin/ats-mini-controller
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
